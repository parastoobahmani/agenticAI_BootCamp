# Copy this file outside version control and replace the placeholder values.
API_KEY=replace-with-provider-key
API_BASE_URL=https://api.openai.com/v1
API_MODEL=gpt-4.1-mini
API_ALLOWED_HOSTS=api.openai.com
API_TIMEOUT_SECONDS=30
API_MAX_OUTPUT_TOKENS=500
API_MAX_CALLS=30
API_STRUCTURED_OUTPUTS=true
API_TOKEN_PARAMETER=max_completion_tokens
# These values only estimate cost in local run records; they do not affect billing.
API_INPUT_USD_PER_MILLION=0
API_OUTPUT_USD_PER_MILLION=0
